# SimCasino settings. Copy this file to ".env" (same folder) and edit.
# Every setting is optional when you just run it on your own computer.

# Port for the API (and, in production, the website too).
PORT=8787

# Database.
# Leave empty to use the built-in database (saved in server/.data/pglite).
# For a hosted Postgres such as Neon, paste its connection string:
# DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
DATABASE_URL=

# Create the demo accounts and two weeks of sample activity when the database is empty.
# Set to false before putting the site online.
SEED_DEMO_DATA=true

# Production only — the public web address(es) of your site, comma-separated.
# APP_ORIGINS=https://your-domain.com

# Set to true when the app runs behind your host's proxy / load balancer,
# so rate limits and security events see the visitor's real IP address.
TRUST_PROXY=false

# Login cookies are HTTPS-only in production. Only set false to test production over plain http.
# COOKIE_SECURE=true
